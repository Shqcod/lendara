APP_NAME="Lendara"
# Nama produk tidak mengubah DB_DATABASE yang sudah dikonfigurasi secara lokal.
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:5173
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kkp_pinjaman_test
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
QUEUE_CONNECTION=database
CACHE_STORE=file
ML_SERVICE_URL=http://127.0.0.1:8001
ML_MODE=stub
ML_INTERNAL_API_KEY=
ML_HTTP_TIMEOUT_SECONDS=20
ML_DEADLINE_SECONDS=120
# ML_SERVICE_URL, ML_MODE, ML_INTERNAL_API_KEY, ML_HTTP_TIMEOUT_SECONDS dibaca config/services.php.
# Deadline domain tetap 120 detik sesuai kontrak; ML_DEADLINE_SECONDS belum dibaca runtime.
# Jangan menimpa .env lama. APP_KEY dibuat php artisan key:generate setelah setup.

